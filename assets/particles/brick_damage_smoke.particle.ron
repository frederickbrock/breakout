// Continuous light smoke from a damaged brick. `spawn_rate` is overridden at
// runtime from the brick's damage and the particle budget (src/particles/).
(
    spawn_rate: 0.4,
    spawn_amount: 1,
    emission_shape: Circle(14.0),
    lifetime: (1.2, 0.3),
    linear_speed: Some((22.0, 0.5)),
    linear_acceleration: None,
    direction: Some(((0.0, 1.0), 0.25)),
    angular_speed: None,
    angular_acceleration: None,
    scale: Some((6.0, 0.5)),
    color: Some((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)),
    gravity_direction: None,
    gravity_speed: None,
    linear_damp: Some((0.6, 0.2)),
    angular_damp: None,
    scale_curve: Some((points: [(0.6, 0.0, None), (1.6, 1.0, None)])),
    color_curve: Some((points: [
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 0.0, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.45), 0.2, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 1.0, None),
    ])),
    attractors: None,
    relative_positioning: None,
)

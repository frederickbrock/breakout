// Small, subtle spark burst where the ball bounces off a wall, brick or the
// paddle. White: tinted by theme::BOUNCE_SPARK (src/particles/).
(
    spawn_rate: 0.05,
    spawn_amount: 8,
    emission_shape: Circle(3.0),
    lifetime: (0.2, 0.3),
    linear_speed: Some((240.0, 0.5)),
    linear_acceleration: None,
    direction: Some(((0.0, 1.0), 1.0)),
    angular_speed: None,
    angular_acceleration: None,
    scale: Some((3.0, 0.4)),
    color: Some((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)),
    gravity_direction: None,
    gravity_speed: None,
    linear_damp: Some((6.0, 0.2)),
    angular_damp: None,
    scale_curve: Some((points: [(1.0, 0.0, None), (0.3, 1.0, None)])),
    color_curve: Some((points: [
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0), 0.0, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 1.0, None),
    ])),
    attractors: None,
    relative_positioning: None,
)

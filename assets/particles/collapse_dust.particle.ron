// Collapse landing dust: a small low puff at the bottom edge of a brick that
// just dropped into its new cell (theme::SMOKE; src/powerups/collapse.rs).
(
    spawn_rate: 0.05,
    spawn_amount: 10,
    emission_shape: Circle(20.0),
    lifetime: (0.45, 0.3),
    linear_speed: Some((60.0, 0.5)),
    linear_acceleration: None,
    direction: Some(((0.0, 1.0), 0.6)),
    angular_speed: None,
    angular_acceleration: None,
    scale: Some((10.0, 0.4)),
    color: Some((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)),
    gravity_direction: None,
    gravity_speed: None,
    linear_damp: Some((3.0, 0.2)),
    angular_damp: None,
    scale_curve: Some((points: [(0.6, 0.0, None), (1.4, 1.0, None)])),
    color_curve: Some((points: [
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 0.0, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.6), 0.1, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 1.0, None),

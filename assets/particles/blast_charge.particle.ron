// Charge blast: a round burst of sparks reaching about one cell all round
// (the 8 neighbours it hits). Played twice, tinted red and orange
// (theme::BLAST_RED / BLAST_ORANGE, src/particles/).
(
    spawn_rate: 0.05,
    spawn_amount: 36,
    emission_shape: Circle(15.0),
    lifetime: (0.45, 0.3),
    linear_speed: Some((600.0, 0.4)),
    linear_acceleration: None,
    direction: Some(((0.0, 1.0), 1.0)),
    angular_speed: None,
    angular_acceleration: None,
    scale: Some((7.0, 0.4)),
    color: Some((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)),
    gravity_direction: None,
    gravity_speed: None,
    linear_damp: Some((4.0, 0.2)),
    angular_damp: None,
    scale_curve: Some((points: [(1.0, 0.0, None), (0.3, 1.0, None)])),
    color_curve: Some((points: [
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0), 0.0, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 1.0, None),
    ])),
    attractors: None,
    relative_positioning: None,
)
